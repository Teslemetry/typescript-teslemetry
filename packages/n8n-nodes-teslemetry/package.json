{
  "name": "@teslemetry/n8n-nodes-teslemetry",
  "version": "0.5.1",
  "description": "n8n nodes for controlling Tesla vehicles and energy sites via Teslemetry API",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsdown && for dir in nodes/*/ credentials/; do cp \"$dir\"*.svg \"dist/$dir\"; done",
    "verify:package": "tsx scripts/verify-package.ts",
    "dev2": "pnpm build && mkdir -p .n8n-home/nodes && ln -sf $(pwd) .n8n-home/nodes/teslemetry && N8N_LOG_OUTPUT=console N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true N8N_USER_FOLDER=$(pwd)/.n8n-home ./node_modules/.bin/n8n start",
    "tsc": "tsc",
    "validate": "n8n-node lint",
    "dev": "n8n-node dev"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "tesla",
    "teslemetry",
    "automation",
    "vehicle",
    "energy",
    "powerwall",
    "iot"
  ],
  "author": {
    "name": "Teslemetry",
    "email": "hello@teslemetry.com",
    "url": "https://teslemetry.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Teslemetry/typescript-teslemetry"
  },
  "bugs": "https://github.com/Teslemetry/typescript-teslemetry/issues/new?template=n8n_bug.yml",
  "homepage": "https://github.com/Teslemetry/typescript-teslemetry/tree/main/packages/n8n-nodes-teslemetry#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TeslemetryApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TeslemetryVehicle/TeslemetryVehicle.node.js",
      "dist/nodes/TeslemetryEnergy/TeslemetryEnergy.node.js",
      "dist/nodes/TeslemetryTrigger/TeslemetryTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.51.5",
    "eslint": "9.29.0",
    "n8n": "^1.122.5",
    "n8n-workflow": "^1.119.1",
    "sqlite3": "^5.1.7",
    "tsdown": "^0.22.4",
    "tsx": "^4.20.6"
  }
}
