  },
  {
    "id": "set_charge_schedule_params",
    "type": "change",
    "z": "tab1",
    "name": "Weeknights 11pm-6am at home",
    "rules": [
      { "t": "set", "p": "daysOfWeek", "pt": "msg", "to": "Weekdays", "tot": "str" },
      { "t": "set", "p": "enabled", "pt": "msg", "to": "true", "tot": "bool" },
      { "t": "set", "p": "startEnabled", "pt": "msg", "to": "true", "tot": "bool" },
      { "t": "set", "p": "endEnabled", "pt": "msg", "to": "true", "tot": "bool" },
      { "t": "set", "p": "startTime", "pt": "msg", "to": "23:00", "tot": "str" },
      { "t": "set", "p": "endTime", "pt": "msg", "to": "06:00", "tot": "str" },
      { "t": "set", "p": "lat", "pt": "msg", "to": "37.7749", "tot": "num" },
      { "t": "set", "p": "lon", "pt": "msg", "to": "-122.4194", "tot": "num" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 300,
    "y": 500,
    "wires": [["vehicle_cmd_add_charge_schedule"]]
  },
