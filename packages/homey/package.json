{
  "name": "com.teslemetry",
  "description": "Adds support for Tesla vehicles and energy products through Teslemetry",
  "version": "0.0.7",
  "private": true,
  "scripts": {
    "build2": "pnpm tsdown && pnpm compose && jq 'del(.devDependencies, .scripts)' package.json > .homeybuild/package.json && pnpm copy",
    "build": "tsdown && pnpm copy && cd .homeybuild && npm install --omit=dev",
    "dev": "homey app run",
    "copy": "copyfiles -aF 'app.json' 'assets/**'  'settings/**' 'locales/**' 'drivers/*/assets/**' 'package.json' '*.md' 'LICENSE' 'README.txt' '.homeybuild'",
    "compose": "node compose.cjs",
    "tsc": "tsc --noEmit",
    "lint": "eslint --ext .js,.ts --ignore-path .gitignore .",
    "dev2": "homey app run",
    "app:run": "pnpm build && homey app run -s",
    "app:install": "pnpm build && homey app install -s",
    "app:validate": "homey app validate --level verified",
    "app:publish": "pnpm build && homey app publish -s",
    "homey": "homey",
    "tsdown": "tsdown",
    "size": "du -sh .homeybuild"
  },
  "dependencies": {},
  "devDependencies": {
    "source-map-support": "^0.5.21",
    "homey": "^3.12.0",
    "@teslemetry/api": "^0.6.7",
    "@tsconfig/node16": "^16.1.8",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^24.10.2",
    "copyfiles": "^2.4.1",
    "eslint": "^7.32.0",
    "eslint-config-athom": "^3.1.5",
    "tsdown": "^0.16.7",
    "typescript": "^5.9.3"
  }
}
