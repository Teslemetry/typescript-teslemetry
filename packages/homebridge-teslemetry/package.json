{
  "name": "homebridge-teslemetry",
  "displayName": "Homebridge Teslemetry",
  "version": "1.0.1",
  "description": "Teslemetry integration for Homebridge with real-time streaming support",
  "author": "Teslemetry",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Teslemetry/typescript-teslemetry.git",
    "directory": "packages/homebridge-teslemetry"
  },
  "bugs": {
    "url": "https://github.com/Teslemetry/typescript-teslemetry/issues"
  },
  "main": "dist/index.cjs",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "tsdown --format cjs",
    "watch": "tsdown --format cjs --watch",
    "tsc": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "homebridge-plugin",
    "tesla",
    "teslemetry",
    "streaming",
    "vehicle",
    "smart-home",
    "iot"
  ],
  "dependencies": {
    "@teslemetry/api": "workspace:*"
  },
  "devDependencies": {
    "hap-nodejs": "^0.14.0",
    "homebridge": "^1.8.0",
    "tsdown": "^0.22.4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
