    "@teslemetry/api": "workspace:*"
  },
  "devDependencies": {
    "homebridge": "^1.8.0",
    "tsdown": "^0.16.7",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "files": [
    "dist",
    "config.schema.json"
