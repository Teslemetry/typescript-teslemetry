    "mode": "daemon",
    "type": "iot-systems",
    "compact": true,
    "connectionType": "cloud",
    "dataSource": "poll",
    "tier": 3,
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=5.0.0"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.0.0"
      }
    ],
    "licenseInformation": {
      "type": "free",
      "license": "Apache-2.0"
    }
  },
  "native": {
    "accessToken": "",
    "region": "auto",
    "pollInterval": 60,
    "enableStreaming": true,
    "selectedVehicles": [],
    "selectedEnergySites": []
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": {
          "en": "Information",
          "de": "Information"
        }
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": {
          "en": "Connected to Teslemetry",
          "de": "Verbunden mit Teslemetry"
        },
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
